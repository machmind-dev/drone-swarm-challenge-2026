# =============================================================================
# ESP-IDF / Drone Firmware (all versions)
# =============================================================================
drone-firmware/**/build/
drone-firmware/**/managed_components/
drone-firmware/**/dependencies.lock
drone-firmware/**/sdkconfig
drone-firmware/**/.cache/
drone-firmware/**/*.o
drone-firmware/**/*.d
drone-firmware/**/*.elf
drone-firmware/**/*.bin
drone-firmware/**/*.map
drone-firmware/log/
# v1.0 micro-ros component is large — keep only colcon.meta
drone-firmware/v1.0/components/micro_ros_espidf_component/
!drone-firmware/v1.0/components/micro_ros_espidf_component/colcon.meta

# =============================================================================
# ROS2 / Colcon (Ground Station)
# =============================================================================
ground-station-software/**/build/
ground-station-software/**/install/
ground-station-software/**/log/
ground-station-software/**/.colcon_install_layout
ground-station-software/**/*.egg-info/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
*.egg

# =============================================================================
# Swarm data — never commit logs or raw telemetry
# =============================================================================
ground-station-software/swarm/data/logs/
ground-station-software/swarm/data/telemetry/

# =============================================================================
# OS / Editor noise
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# =============================================================================
# Archives (not tracked)
# =============================================================================
*.zip
*.tar.gz
*.tar.bz2

# Binary files (images, video, CAD) are tracked via Git LFS — see .gitattributes
