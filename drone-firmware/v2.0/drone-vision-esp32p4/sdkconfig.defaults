# CPU frequency is configured at runtime via esp_pm_configure() in main.c
# (locked at 360 MHz, DFS disabled to avoid ESP32-P4 eco2 L2 cache errata).

CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000

# Flash -- Waveshare ESP32-P4-Pico board has 16 MB flash
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Waveshare ESP32-P4-WiFi6 board: WCH CH343 USB-UART bridge (1a86:55d3) on UART0
# → /dev/ttyACM0.  UART_CUSTOM is required so ESP_CONSOLE_UART_BAUDRATE is
# visible to Kconfig (with DEFAULT the baud rate is locked to 115200 invisibly).
# 921600 baud: DETECTION_STREAM sends ~9.6 KB/frame at ~3 fps = ~28 KB/s;
# 921600 (~92 KB/s effective) gives comfortable headroom.  At 115200 the UART
# saturates → fwrite blocks → fps drops to 1.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# Flash baud rate — esptool default is 460800 which causes CH343 burst dropouts.
# 230400 is stable on the CH343 bridge; flash time increases by ~30 s on a 3 MB
# binary but is far more reliable than a failed flash that corrupts the image.
CONFIG_ESPTOOLPY_BAUD_230400B=y

# -- Power management ---------------------------------------------------------
CONFIG_PM_ENABLE=y
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set

# -- PSRAM -- Waveshare board has 32 MB external PSRAM (16-line HEX mode) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=131072

# -- Camera sensor -- OV5647 MIPI-CSI ----------------------------------------
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
# OV5647 driver uses this unconditionally (reg 0x4800) -- must be defined.
# ISP is configured with has_line_start_packet=true to match.
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y

# -- ISP pipeline controller --------------------------------------------------
# Required for V4L2 API: without this, isp_task never drives the CSI DMA and
# VIDIOC_DQBUF blocks forever.  Log interleaving from this task is suppressed
# inside camera_view_mode() via esp_log_level_set("*", ESP_LOG_NONE).
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_ISP_CTRL_FUNC_IN_IRAM=y
CONFIG_I2C_ISR_IRAM_SAFE=y

# -- IDF experimental features ------------------------------------------------
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# -- Drone Vision -- pose estimation ------------------------------------------
CONFIG_VISION_POSE_MARKER_SIZE_CM=50
CONFIG_VISION_ARUCO_DICT=0
